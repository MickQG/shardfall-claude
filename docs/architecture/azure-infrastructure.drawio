        <mxCell id="rg" value="Resource group rg-shardfall · West Europe" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0078D4;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=50;spacingTop=10;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1">
