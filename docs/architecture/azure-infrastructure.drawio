        <!-- Static Web App: one resource holding the game files, its built-in Functions and its settings -->
        <mxCell id="swa" value="&lt;b&gt;swa-shardfall&lt;/b&gt; · Static Web App (Free)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;One resource: everything in this box is part of it&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=52;spacingTop=6;fontStyle=1;fontColor=#0b4f8a;" vertex="1" parent="1">
