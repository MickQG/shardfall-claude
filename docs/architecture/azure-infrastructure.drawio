              <mxPoint x="340" y="253" />
              <mxPoint x="340" y="502" />
            </Array>
            <mxPoint x="120" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="eB4" value="④ WebSocket (WSS)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.642;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" source="browserB" target="pubsub" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- 5: deploy -->
        <mxCell id="e5" value="⑤ deploy" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.684;entryY=0;entryDx=0;entryDy=0;" edge="1" source="github" target="swa" parent="1">
          <mxGeometry relative="1" as="geometry">
            </mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Traffic&lt;/b&gt;&lt;br&gt;① Game files over HTTPS, once per visit, then cached by the browser.&lt;br&gt;② Multiplayer only: get a room code and a 1-hour token that only allows sending to that room.&lt;br&gt;③ The function signs the token itself with the stored key; it never calls Web PubSub.&lt;br&gt;④ Lockstep play: each player sends its orders every 125 ms and a checksum every 4 s; Web PubSub forwards them to the other player.&lt;br&gt;⑤ A push to main deploys production; each pull request gets its own preview environment.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="660" width="1110" height="110" as="geometry" />
        </mxCell>

