        <!-- 3: settings -->
        <mxCell id="e3" value="③ reads the key" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#d6b656;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="func" target="settings" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 4: websockets -->
        <mxCell id="eA4" value="④ WebSocket (WSS)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="browserA" target="pubsub" parent="1">
          <mxGeometry relative="1" as="geometry">
