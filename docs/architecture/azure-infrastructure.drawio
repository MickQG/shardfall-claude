        <mxCell id="browserA" value="&lt;b&gt;Player A (host)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Game simulation in a Web Worker,&lt;br&gt;three.js renderer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="170" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="browserB" value="&lt;b&gt;Player B (guest)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Joins with the host's room code.&lt;br&gt;Also makes calls ① and ② like Player A&lt;br&gt;(not drawn, to keep the picture clear)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sp-note" value="Single player needs only ①: the whole game, including the AI opponent, runs in the browser." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#555555;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="580" width="220" height="50" as="geometry" />
        </mxCell>

