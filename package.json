{
  "name": "shardfall",
  "version": "0.1.0",
  "description": "Shardfall: an original isometric RTS for the web",
  "author": "MickQG",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "check": "npm run lint && npm run typecheck && npm test && npm run trace",
    "test:matches": "vitest run --config vitest.matches.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "trace": "tsx scripts/trace.ts",
    "bench": "tsx scripts/bench.ts",
    "e2e": "playwright test",
    "harness": "tsx scripts/harness.ts",
    "ai:length": "tsx scripts/match-length.ts",
    "sprites": "tsx scripts/sprites.ts",
    "icon": "tsx scripts/icon.ts",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MickQG/shardfall-claude.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MickQG/shardfall-claude/issues"
  },
  "homepage": "https://github.com/MickQG/shardfall-claude#readme",
  "dependencies": {
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "build": {
    "appId": "com.shardfall.game",
    "productName": "Shardfall",
    "directories": {
      "buildResources": "desktop",
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Shardfall-${version}-${os}-${arch}.${ext}"
  }
}
