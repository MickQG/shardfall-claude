{
  "name": "shardfall",
  "version": "0.1.0",
  "description": "Shardfall: an original isometric RTS for the web",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "trace": "tsx scripts/trace.ts",
    "bench": "tsx scripts/bench.ts",
    "e2e": "playwright test",
    "harness": "tsx scripts/harness.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MickQG/shardfall-claude.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MickQG/shardfall-claude/issues"
  },
  "homepage": "https://github.com/MickQG/shardfall-claude#readme",
  "dependencies": {
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
